<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The localization gate reads both hosts' markup and registers both catalogs. UiText is process-wide
         static state, so the two projects it shares with are referenced rather than duplicated in the test. -->
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
    <ProjectReference Include="..\..\src\FluentJalium.Localization\FluentJalium.Localization.csproj" />
    <ProjectReference Include="..\..\samples\FluentJalium.Gallery\FluentJalium.Gallery.csproj" />
    <ProjectReference Include="..\..\samples\FluentJalium.Launcher\FluentJalium.Launcher.csproj" />
  </ItemGroup>

</Project>
