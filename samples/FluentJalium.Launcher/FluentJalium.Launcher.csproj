<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FluentJalium.Launcher</RootNamespace>
    <AssemblyName>FluentJalium.Launcher</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <JalxamlPage Include="*.jalxaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
    <ProjectReference Include="..\..\src\FluentJalium.Localization\FluentJalium.Localization.csproj" />
    <!-- The launcher hands the chosen backend and engine to the Gallery and then shows it, so the
         Gallery's MainWindow is a referenced type rather than a second process. Its Catalog.json travels
         with the reference (Gallery declares it CopyToOutputDirectory) and GalleryCatalog.Load resolves it
         against AppContext.BaseDirectory, which is the launcher's output directory here. -->
    <ProjectReference Include="..\FluentJalium.Gallery\FluentJalium.Gallery.csproj" />
    <PackageReference Include="Jalium.UI.Desktop" Version="$(JaliumPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- LauncherText is internal for the same reason GalleryText is; the coverage gate registers it rather than
         re-declaring the launcher's strings. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FluentJalium.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
