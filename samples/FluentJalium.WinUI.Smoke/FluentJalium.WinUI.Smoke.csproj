<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M0 proof: an app whose page markup is copied verbatim from the WinUI Gallery.
    Nothing in Controls\SampleThemeListener.xaml* was edited for this port.
  -->
  <Import Project="..\..\src\FluentJalium.WinUI.Build\buildTransitive\FluentJalium.WinUI.Build.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FluentJalium.WinUI.Smoke</RootNamespace>
    <AssemblyName>FluentJalium.WinUI.Smoke</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentJalium.WinUI\FluentJalium.WinUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jalium.UI.Desktop" Version="$(JaliumPackageVersion)" />
  </ItemGroup>

  <Import Project="..\..\src\FluentJalium.WinUI.Build\buildTransitive\FluentJalium.WinUI.Build.targets" />

</Project>
