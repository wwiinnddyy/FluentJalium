<UserControl xmlns="http://schemas.jalium.ui/2024"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
             x:Class="FluentJalium.Gallery.Controls.GalleryLinkCard"
             Width="248"
             MinHeight="142">
    <fw:FWButton x:Name="RootButton"
                 Padding="18"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
        <fw:FWStackPanel Orientation="Vertical" Spacing="10">
            <fw:FWFontIcon x:Name="IconPresenter"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="24"
                           Width="24"
                           Height="24"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <fw:FWTextBlock x:Name="TitlePresenter"
                            Style="{StaticResource GalleryCardTitle}" />
            <fw:FWTextBlock x:Name="DescriptionPresenter"
                            Style="{StaticResource GalleryCardDescription}"
                            FontSize="13" />
        </fw:FWStackPanel>
    </fw:FWButton>
</UserControl>
