<UserControl xmlns="http://schemas.jalium.ui/2024"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
             x:Class="FluentJalium.Gallery.Controls.ControlExample"
             Margin="0,16,0,0">

    <StackPanel>
        <TextBlock x:Name="HeaderTextPresenter"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Margin="0,12" />

        <fw:FWBorder CornerRadius="8"
                     ClipToBounds="True"
                     Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Example display  -->
                    <fw:FWBorder x:Name="ExampleHost"
                                 MinHeight="180"
                                 Padding="12"
                                 HorizontalAlignment="Stretch"
                                 Background="{ThemeResource ControlExampleDisplayBrush}" />

                    <!--  Output display  -->
                    <fw:FWBorder x:Name="OutputHost"
                                 Grid.Column="1"
                                 Margin="0,12,12,12"
                                 Padding="16"
                                 VerticalAlignment="Stretch"
                                 CornerRadius="8"
                                 Visibility="Collapsed"
                                 Background="{ThemeResource ControlExampleDisplayBrush}">
                        <StackPanel>
                            <TextBlock Text="Output:" Style="{StaticResource BodyTextBlockStyle}" />
                            <ContentControl x:Name="OutputContentHost" Margin="0,8,0,0" />
                        </StackPanel>
                    </fw:FWBorder>

                    <!--  Options display  -->
                    <fw:FWBorder x:Name="OptionsHost"
                                 Grid.Column="2"
                                 Padding="16"
                                 VerticalAlignment="Stretch"
                                 Visibility="Collapsed"
                                 BorderThickness="1,0,0,0"
                                 Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                 BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>

                <!--  Source code display  -->
                <fw:FWExpander x:Name="SourceExpander"
                               Header="Source code"
                               Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel>
                        <fw:FWSelectorBar x:Name="SourceSelector" Margin="4,8,0,0" SelectedIndex="0">
                            <fw:FWSelectorBarItem Text="XAML" />
                            <fw:FWSelectorBarItem Text="C#" />
                        </fw:FWSelectorBar>
                        <fw:FWScrollViewer MaxHeight="360"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="SourceCodePresenter"
                                       Margin="16,12,16,16"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       TextWrapping="NoWrap" />
                        </fw:FWScrollViewer>
                    </StackPanel>
                </fw:FWExpander>
            </StackPanel>
        </fw:FWBorder>
    </StackPanel>
</UserControl>
