<UserControl xmlns="http://schemas.jalium.ui/2024"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
             x:Class="FluentJalium.Gallery.Pages.VisualSample">
    <fw:FWStackPanel Orientation="Horizontal" Spacing="20">
        <fw:FWPersonPicture Initials="FJ"
                            DisplayName="FluentJalium"
                            BadgeNumber="3"
                            Width="64"
                            Height="64" />
        <fw:FWRectangle Width="110"
                        Height="64"
                        RadiusX="10"
                        RadiusY="10"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <fw:FWEllipse Width="64"
                      Height="64"
                      Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </fw:FWStackPanel>
</UserControl>
