<UserControl xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
      x:Class="FluentJalium.Gallery.Shell.GalleryItemView">

    <fw:FWScrollViewer HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ContentRoot" Margin="36,24,36,36">

            <!--  Page header: title/API on the left, actions on the right  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="TitlePresenter"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <fw:FWBorder x:Name="StatusPill"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"
                                 CornerRadius="999"
                                 Padding="9,3,9,3"
                                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                                 BorderBrush="{ThemeResource ControlBorder}"
                                 BorderThickness="1">
                        <TextBlock x:Name="StatusText"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextSecondary}" />
                    </fw:FWBorder>
                    <fw:FWDropDownButton x:Name="InfoDrop"
                                         Content="?"
                                         Padding="10,0"
                                         VerticalAlignment="Center"
                                         ShowChevronArrow="False" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <fw:FWButton x:Name="ThemeButton" />
                    <fw:FWButton x:Name="CopyButton" />
                    <fw:FWToggleButton x:Name="FavoriteToggle">
                        <TextBlock x:Name="FavoriteGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                    </fw:FWToggleButton>
                </StackPanel>
            </Grid>

            <!--  Documentation and source menus  -->
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                <fw:FWDropDownButton x:Name="DocsDrop" />
                <fw:FWDropDownButton x:Name="SourceDrop" />
            </StackPanel>

            <TextBlock x:Name="DescriptionPresenter"
                       Margin="0,12,0,0"
                       MaxWidth="1064"
                       HorizontalAlignment="Left"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!--  Sample content  -->
            <ContentControl x:Name="SampleHost" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" />

            <!--  Related controls  -->
            <fw:FWExpander x:Name="RelatedExpander"
                           Margin="0,16,0,0"
                           Header="Related controls"
                           Visibility="Collapsed">
                <StackPanel x:Name="RelatedPanel" Spacing="4" />
            </fw:FWExpander>
        </StackPanel>
    </fw:FWScrollViewer>
</UserControl>
