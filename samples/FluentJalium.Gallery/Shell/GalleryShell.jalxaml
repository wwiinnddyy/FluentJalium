<UserControl xmlns="http://schemas.jalium.ui/2024"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
             x:Class="FluentJalium.Gallery.Shell.GalleryShell">
    <fw:FWNavigationView x:Name="Navigation"
                         Density="Comfortable"
                         PaneDisplayMode="Left"
                         IsPaneOpen="True"
                         OpenPaneLength="280"
                         CompactPaneLength="48"
                         PaneBackground="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                         ContentBackground="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                         AutomationProperties.AutomationId="GalleryNavigation">
        <fw:FWNavigationView.PaneHeader>
            <fw:FWCardSurface x:Name="BrandCard"
                              Padding="14,14,12,14"
                              Margin="8,8,8,10"
                              AutomationProperties.AutomationId="GalleryBrand">
                <fw:FWStackPanel Orientation="Vertical" Spacing="12">
                    <fw:FWStackPanel Orientation="Horizontal" Spacing="12">
                        <fw:FWFontIcon Glyph="&#xECAA;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="28"
                                       Width="28"
                                       Height="28"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                        <fw:FWStackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <fw:FWTextBlock Text="FluentJalium" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <fw:FWTextBlock Text="Control Gallery" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </fw:FWStackPanel>
                    </fw:FWStackPanel>
                    <fw:FWToggleSwitch x:Name="ThemeSwitch"
                                       Header="Dark theme"
                                       IsOn="True"
                                       Description="Use Fluent theme resources" />
                </fw:FWStackPanel>
            </fw:FWCardSurface>
        </fw:FWNavigationView.PaneHeader>
        <fw:FWNavigationView.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <fw:FWAutoSuggestBox x:Name="SearchBox"
                                    Width="360"
                                    Margin="40,20,40,18"
                                    HorizontalAlignment="Right"
                                    PlaceholderText="Search controls and patterns" />
                <ContentControl x:Name="ContentHost"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </fw:FWNavigationView.Content>
    </fw:FWNavigationView>
</UserControl>
