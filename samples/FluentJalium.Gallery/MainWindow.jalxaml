<Window xmlns="http://schemas.jalium.ui/2024"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fw="clr-namespace:FluentJalium.Controls;assembly=FluentJalium"
        x:Class="FluentJalium.Gallery.MainWindow"
        Title="FluentJalium Gallery"
        Width="1360"
        Height="860"
        MinWidth="920"
        MinHeight="600"
        Background="Transparent">
    <Grid>
        <fw:FWBackdrop x:Name="Backdrop"
                       Type="Mica"
                       TintOpacity="0.86"
                       LuminosityOpacity="0.92" />
        <ContentControl x:Name="ShellHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
