<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FluentJalium.Gallery</RootNamespace>
    <AssemblyName>FluentJalium.Gallery</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <JalxamlPage Include="*.jalxaml" />
    <!-- The parity strip and the catalog gate read the same file; it has to travel with the app. -->
    <None Include="Catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/FluentJalium/FluentJalium.csproj" />
    <PackageReference Include="Jalium.UI.Desktop" Version="$(JaliumPackageVersion)" />
  </ItemGroup>
</Project>
