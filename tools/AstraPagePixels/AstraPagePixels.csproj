<Project Sdk="Microsoft.NET.Sdk">

  <!-- The page-level pixel gate, run as its own process on purpose. Rendering the Gallery inside the
       shared test host is not viable: every page whose template realises a dropdown leaves that subtree
       grafted into the host window's overlay layer, and the suite resolves popup parts by name from the
       same host, so unrelated controls start measuring the Gallery's parts (measured 2026-09-22, 6 gallery
       captures -> 4 stale "SuggestionsContainer" nodes, 5 items hosts; docs/astra/ROADMAP.md "#10 缺口②").
       Not referenced by FluentJalium.slnx; invoked by tools/Test-AstraGates.ps1. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AstraPagePixels</RootNamespace>
    <AssemblyName>AstraPagePixels</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
    <ProjectReference Include="..\..\samples\FluentJalium.Gallery\FluentJalium.Gallery.csproj" />
    <PackageReference Include="Jalium.UI.Desktop" Version="$(JaliumPackageVersion)" />
  </ItemGroup>

</Project>
