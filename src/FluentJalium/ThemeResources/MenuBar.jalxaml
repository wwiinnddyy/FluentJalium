<!-- WinUI 3 MenuBar_themeresources.xaml @19e3bdc3ccf3361393d623d3a5d2667cb8f33229 (MIT),
     blob 96cf1b1e788a327c5c00e07af0e3fc3cbf23e40b, Light/Default branch (lines 18-28) plus the two
     Thickness rows declared outside the theme dictionaries at lines 45-46, where upstream also declares
     them (they are read as {StaticResource}/{ThemeResource} from MenuBarItem.xaml, so the placement is
     copied rather than "fixed").
     Six alias rows and three Thickness rows, all read by Styles/Menus.jalxaml.
     What upstream has and this dictionary does not: MenuBarItemBackgroundPressed, MenuBarItemBackgroundSelected,
     MenuBarItemBorderBrushPressed and MenuBarItemBorderBrushSelected, because 26.10.9's MenuBarItem carries
     one dependency property - Title - and no press, selection or checked flag a state cell could watch;
     upstream's fourth visual state is literally named Selected and this runtime has no state that maps to it
     (spike/MenuProbe pass 2 and 4). MenuBarHeight (40) is an x:Double, which this reader cannot parse, so it
     rides as a literal on the bar's MinHeight. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Thickness x:Key="MenuBarItemBorderThickness">0</Thickness>
  <Thickness x:Key="MenuBarItemButtonPadding">10,4,10,4</Thickness>
  <Thickness x:Key="MenuBarItemMargin">4,4,4,4</Thickness>
  <StaticResource x:Key="MenuBarBackground" ResourceKey="SubtleFillColorTransparentBrush" />
  <StaticResource x:Key="MenuBarItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
  <StaticResource x:Key="MenuBarItemBackground" ResourceKey="SubtleFillColorTransparentBrush" />
  <StaticResource x:Key="MenuBarItemBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
  <StaticResource x:Key="MenuBarItemBorderBrush" ResourceKey="ControlAltFillColorTertiaryBrush" />
  <StaticResource x:Key="MenuBarItemBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefaultBrush" />
</ResourceDictionary>
