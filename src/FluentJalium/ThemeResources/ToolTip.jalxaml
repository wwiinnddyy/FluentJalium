<!-- WinUI 3 ToolTip_themeresources.xaml @19e3bdc3c (MIT), blob 281d1efcf02c33f81b32fd04e2c691da9173a323.
     Only the keys our own DefaultToolTipStyle consumes are transcribed; see audits/tooltip.md for the
     two upstream keys deliberately left out and why. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- All three resolve to the palette objects the kernel re-tints in place, so the upstream names
       follow the theme flip and the high-contrast decision made for the key below them. -->
  <StaticResource x:Key="ToolTipForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
  <!-- Upstream's own name for the tooltip surface is the in-app acrylic material; this runtime cannot
       composite it into a popup, and the palette carries it as upstream's FallbackColor solid. -->
  <StaticResource x:Key="ToolTipBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
  <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
  <!-- 1 in every branch, high contrast included, so unlike the flyout border this has no HC gap. -->
  <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
  <Thickness x:Key="ToolTipBorderPadding">9,6,9,8</Thickness>
</ResourceDictionary>
