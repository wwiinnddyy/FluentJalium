<!-- WinUI 3 NavigationView_themeresources.xaml @19e3bdc3ccf3361393d623d3a5d2667cb8f33229 (MIT),
     blob aa3ff11b2c3128dd198d7140417594cfa6fe5c74. Its ThemeDictionaries are Default (4-69), Light (70-135) and
     High Contrast (136-201), and each carries 64 rows. Counted, not eyeballed: Default and Light are identical
     name-for-name AND target-for-target (sorted multisets compare equal), so this is one scope-independent alias
     layer rather than a per-theme pair - the same shape ComboBox.jalxaml settled on. High Contrast keeps the same
     64 names and re-points them to SystemControl*/SystemColor*, which our ThemeResources/HighContrast.map already
     drives underneath the token aliases: aliasing one level down (NavigationViewItemBackgroundSelected ->
     SubtleFillColorSecondaryBrush -> the map) reaches HC without a second copy of the block.
     19 of the 64 alias rows are here because Styles/Navigation.jalxaml reads them; the other 45 and the reason
     for each group are docs/astra/audits/navigation.md §2, and the withheld names are pinned by
     AstraNavigationTests.A_row_this_control_does_not_build_is_not_published. No name below is invented: the one
     name our library used to publish that upstream does not have (NavigationViewItemCornerRadius) is withdrawn -
     audits/navigation.md §3. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Items, fills. Upstream's left pane selects with a subtle pill, not an accent block - the same family as
       TreeViewItem and ListViewItem. The interesting pair is Pressed vs SelectedPointerOver: pressing a selected
       row goes BACK one step (Secondary), which is why our two multi-state triggers have to name these rather
       than compute a blend. -->
  <StaticResource x:Key="NavigationViewItemBackground" ResourceKey="SubtleFillColorTransparentBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
  <StaticResource x:Key="NavigationViewItemBackgroundSelectedDisabled" ResourceKey="SubtleFillColorSecondaryBrush" />
  <!-- Items, text. Upstream writes these onto the presenter's Foreground inside each visual state
       (MUX_NavigationViewItemPresenterStyleWhenOnLeftPane, :459-462 and its siblings); ours writes the control's
       own Foreground and lets the label and the icon inherit it, which is the only route this runtime has -
       Styles/Navigation.jalxaml carries the reading. Two of the eight step down to TextFillColorSecondary, and
       both of them are press rows: navigation dims its text while the pointer is down and brings it back up. -->
  <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="TextFillColorPrimaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="TextFillColorPrimaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="TextFillColorSecondaryBrush" />
  <StaticResource x:Key="NavigationViewItemForegroundSelectedDisabled" ResourceKey="TextFillColorDisabledBrush" />
  <!-- The host. NavigationViewContentBackground is the pane's content card, and the grid border is the hairline
       around it; upstream reads both in its own template, and ours reads the same pair under the same names.
       The indicator is the accent pill on the pane's left edge - upstream calls it a Foreground row and writes it
       onto a Rectangle's Fill (:602), so the name stays and a Fill is what consumes it here. -->
  <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="LayerFillColorDefaultBrush" />
  <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
  <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
  <!-- Geometry. Upstream keeps 63 metric rows outside the ThemeDictionaries (:203-265): 20 are x:Double, which
       this reader cannot parse as a resource at all, 3 are the content-grid CornerRadius rows for a pane shape
       this template draws itself, and 40 are Thickness rows. Exactly one of those 40 has something in our markup
       that reads it, and that is the one below; every other name is either a literal in
       Styles/Navigation.jalxaml or belongs to a surface this control does not build (top pane, overflow,
       auto-suggest area, header). audits/navigation.md §2 lists all 63 by name with its reason. -->
  <Thickness x:Key="NavigationViewItemButtonMargin">4,2</Thickness>
</ResourceDictionary>
