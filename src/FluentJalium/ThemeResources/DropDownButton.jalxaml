<!-- WinUI 3 DropDownButton_themeresources.xaml @19e3bdc3ccf3361393d623d3a5d2667cb8f33229 (MIT),
     blob c1e68023c2f729b36e83b7fc6b91ed7e0d2e97fe, Light/Default branch (lines 5-7): three rows, and that
     is the whole file. Upstream's drop-down paints its surface with the Button* rows (DropDownButton.xaml
     blob aa07b40c6f40b28c347ab25fd73a8ba36524505f, lines 4-16) and only the chevron has names of its own,
     so this dictionary is the chevron and nothing else. All three are read by DefaultDropDownButtonStyle
     in Styles/Common.jalxaml; the rest row is the one upstream sets directly on the AnimatedIcon. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StaticResource x:Key="DropDownButtonForegroundSecondary" ResourceKey="TextFillColorSecondaryBrush" />
  <StaticResource x:Key="DropDownButtonForegroundSecondaryPointerOver" ResourceKey="TextFillColorTertiaryBrush" />
  <StaticResource x:Key="DropDownButtonForegroundSecondaryPressed" ResourceKey="TextFillColorTertiaryBrush" />
</ResourceDictionary>
