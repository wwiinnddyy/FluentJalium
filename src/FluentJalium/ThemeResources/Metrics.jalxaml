<!-- WinUI 19e3bdc3c: the corner-radius and padding rows every batch reads and no single control owns -
     ControlCornerRadius / OverlayCornerRadius from CommonStyles/CornerRadius, ButtonPadding from
     Button_themeresources. Units are device-independent pixels; literal numeric setters avoid the pinned
     Jalium reader's x:Double limitation.
     Three rows used to live here and are gone: RadioButtonContentMargin and MenuFlyoutItemCornerRadius were
     invented names with no upstream row behind them (upstream puts that spacing on the control's own Padding
     setter, and the menu item corner radius is not a resource), and NavigationViewItemButtonMargin is a real
     upstream row that nothing read yet - an idle name only looks overridable. All three come back with the
     batch that consumes them; ThemeResources/Metrics.jalxaml is now held to the same key-consumption gate as
     the per-control dictionaries, so a row cannot sit here unused again.
     NavigationViewItemCornerRadius is now gone too, and for the opposite reason: it was never idle, our template
     read it every day - it was a name upstream does not have. microsoft-ui-xaml @19e3bdc3c carries zero hits for
     it, and the left-pane presenter sets CornerRadius to OverlayCornerRadius instead (NavigationView_themeresources
     .xaml:447, blob aa3ff11b2), so the row was ControlCornerRadius's value wearing a navigation name and the pane
     items were 4 DIP round where WinUI draws 8. Styles/Navigation.jalxaml now reads OverlayCornerRadius;
     docs/astra/audits/navigation.md §3 records the withdrawal and the pixel reading that followed it. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <Thickness x:Key="ButtonPadding">11,5,11,6</Thickness>
</ResourceDictionary>
