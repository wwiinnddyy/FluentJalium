<?xml version="1.0" encoding="utf-8"?>
<!-- Source baseline: microsoft-ui-xaml 19e3bdc3c, NavigationView_themeresources.xaml (blob aa3ff11b2) plus the
     left-pane presenter style in the same file (:440-500) and NavigationView.xaml's pane layout.
     The flat left pane uses a single shared selection indicator outside item clips.
     Every colour on the item is a NavigationViewItem* name from ThemeResources/NavigationView.jalxaml, not a
     palette token read directly: the pixels were already right, but a name that is not published cannot be
     overridden, which is the whole point of the token layer (docs/astra/audits/navigation.md §1). -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FluentJalium.Controls;assembly=FluentJalium">
  <!-- The pane toggle keeps the generic subtle rows. Upstream's six NavigationViewButton* names are not this
       button's: they are read by NavigationBackButton.xaml:26-52, and this control builds no back button, so
       publishing them here would name a surface nobody draws (audits/navigation.md §2). -->
  <Style x:Key="FluentNavigationPaneToggleButtonStyle" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{ThemeResource FocusVisualRingStyle}" />
    <!-- PaneToggleButtonWidth=40 / PaneToggleButtonHeight=36 are upstream's own numbers, but x:Double rows are
         unparseable in this reader, so the pair rides as literals. -->
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
          <Border Name="Root" Shape="RoundedRectangle" CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" TransitionProperty="Background"
                  TransitionDuration="{ThemeResource ControlFasterAnimationDuration}" TransitionTimingFunction="Recommended">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundDisabled}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style x:Key="FluentNavigationItemStyle" TargetType="local:FluentNavigationItem">
    <Setter Property="FocusVisualStyle" Value="{ThemeResource FocusVisualRingStyle}" />
    <Setter Property="MinWidth" Value="0" />
    <!-- NavigationViewItemOnLeftMinHeight is an x:Double row (:217), so the 36 rides as a literal. -->
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Margin" Value="{ThemeResource NavigationViewItemButtonMargin}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{ThemeResource NavigationViewItemBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForeground}" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- Upstream's left-pane presenter sets this to OverlayCornerRadius (:447), not to a navigation-specific row:
         the name NavigationViewItemCornerRadius this style used to read does not exist anywhere in
         microsoft-ui-xaml (git grep at 19e3bdc3c: 0 hits), and its 4 was ControlCornerRadius's value wearing a
         navigation name. audits/navigation.md §3 is the withdrawal. -->
    <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate TargetType="local:FluentNavigationItem">
        <Grid Background="Transparent" MinHeight="36">
          <Border Name="Root" Shape="RoundedRectangle" CornerRadius="{TemplateBinding CornerRadius}"
                  Background="{TemplateBinding Background}" TransitionProperty="Background"
                  TransitionDuration="{ThemeResource ControlFasterAnimationDuration}" TransitionTimingFunction="Recommended">
            <Grid>
              <Grid.ColumnDefinitions>
                <!-- NavigationViewIconBoxWidth (40) and NavigationViewItemOnLeftIconBoxHeight (16) are x:Double
                     rows (:209, :219); both values ride as literals on the column and the icon. -->
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Content="{TemplateBinding Icon}" Width="16" Height="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
              <!-- The presenter's own TextWrapping attribute is accepted by the reader and goes nowhere, and
                   Jalium's generated text element defaults to Wrap, so a long pane label grew the row to
                   55.3 DIP and pushed the rest of the list down. The promise has to sit on the text element
                   the presenter builds - the same route the ToolTip style takes for the opposite direction.
                   Upstream never has to say it: its TextBlock default is NoWrap, and the header style
                   restates it (NavigationView_themeresources.xaml:1085). -->
              <ContentPresenter Name="PART_Label" Grid.Column="1" Margin="0,0,12,0"
                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="NoWrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <!-- Order is the state map: the single-state rows first, then the pairs that qualify them, so a
               selected-and-hovered row wins over a merely hovered one. Upstream's own pointer-over/pressed
               setters inside MUX_NavigationViewItemPresenterStyleWhenOnLeftPane (:459-470) are the same
               precedence expressed in a VisualStateGroup. -->
          <Trigger Property="IsCompact" Value="True">
            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundSelected}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundSelected}" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundPointerOver}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundPointerOver}" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundPressed}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundPressed}" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundDisabled}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundDisabled}" />
          </Trigger>
          <!-- The two rows that are not a blend of their singles: pressing a selected item steps the fill BACK
               up to Secondary and the text down to Secondary, which is why upstream carries a name per pair
               instead of compositing. -->
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True" />
              <Condition Property="IsMouseOver" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundSelectedPointerOver}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundSelectedPointerOver}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True" />
              <Condition Property="IsPressed" Value="True" />
              <Condition Property="IsEnabled" Value="True" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundSelectedPressed}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundSelectedPressed}" />
          </MultiTrigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True" />
              <Condition Property="IsEnabled" Value="False" />
            </MultiTrigger.Conditions>
            <Setter TargetName="Root" Property="Background" Value="{ThemeResource NavigationViewItemBackgroundSelectedDisabled}" />
            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForegroundSelectedDisabled}" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style x:Key="FluentNavigationViewStyle" TargetType="local:FluentNavigationView">
    <Setter Property="Background" Value="{ThemeResource NavigationViewContentBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForeground}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate TargetType="local:FluentNavigationView">
        <!-- The pane's own surface. Upstream asks for NavigationViewDefaultPaneBackground, which is
             AcrylicInAppFillColorDefaultBrush - a backdrop material this library has not characterised yet, so
             the pane sits on the base solid and the difference is recorded as owed (audits/navigation.md §4). -->
        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <!-- 240 is OpenPaneLength's default on the control, not a row upstream publishes. -->
          <Border Name="PART_PaneRoot" Width="240" ClipToBounds="True"
                  TransitionProperty="Width" TransitionDuration="{ThemeResource SplitViewPaneAnimationOpenDuration}" TransitionTimingFunction="Recommended">
            <Grid Margin="0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Button Name="PART_PaneToggle" Style="{StaticResource FluentNavigationPaneToggleButtonStyle}"
                      Margin="4,0,4,12" HorizontalAlignment="Left">
                <!-- The glyph has to be handed the button's ink as a live value, not left to the framework's
                     draw-time walk: an IconElement with no foreground of its own resolves one by walking to an
                     ancestor Control while it draws, and nothing invalidates it when that answer changes, so a
                     live theme switch left this glyph painted with the previous theme's ink (#94 measured the
                     same route on the item icons, audits/navigation.md §10). -->
                <SymbolIcon Symbol="GlobalNavButton" Width="16" Height="16"
                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <!-- Auto reserves 12 DIP for the bar (measured: a 48-DIP viewport hands its content 36),
                   which squeezes the 40-DIP icon column and leaves the selection pill narrower than the
                   icon it is supposed to sit behind. Hidden reserves nothing and still scrolls. -->
              <ScrollViewer Name="PART_MenuScrollViewer" Grid.Row="1"
                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="PART_MenuItems" />
              </ScrollViewer>
              <StackPanel Name="PART_FooterMenuItems" Grid.Row="2" Margin="0,12,0,0" />
              <Canvas Name="PART_IndicatorLayer" Grid.RowSpan="3" IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
                <!-- The pill's geometry is upstream's (:602 reads three x:Double rows for it - Width 3, Height 16,
                     Radius 2) and all three ride as literals because this reader cannot parse an x:Double resource.
                     Height 16 is duplicated on the code side as NavigationIndicatorAnimator.RestingHeight, which is
                     what centres the pill against a 36-DIP row; AstraNavigationTests pins the two to each other. -->
                <Border Name="PART_SelectionIndicator" Width="3" Height="16" CornerRadius="2" Opacity="0"
                        Background="{ThemeResource NavigationViewSelectionIndicatorForeground}" IsHitTestVisible="False" Focusable="False" />
              </Canvas>
            </Grid>
          </Border>
          <Border Grid.Column="1" Margin="0,8,8,8" Background="{TemplateBinding Background}"
                  BorderBrush="{ThemeResource NavigationViewContentGridBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style TargetType="local:FluentNavigationItem" BasedOn="{StaticResource FluentNavigationItemStyle}" />
  <Style TargetType="local:FluentNavigationView" BasedOn="{StaticResource FluentNavigationViewStyle}" />
</ResourceDictionary>
