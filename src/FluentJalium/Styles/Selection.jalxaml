<!-- WinUI CheckBox/ComboBox state definitions @19e3bdc3c; Jalium 26.10.9 part contracts. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The twelve cells upstream's CombinedStates group writes (three check states x rest/PointerOver/Pressed/Disabled),
       each carrying the same six properties upstream animates: content foreground, root background and border, surface
       fill and stroke, glyph foreground. Upstream's resting Unchecked cell lives in the setters below, and its
       Unchecked/Checked/Indeterminate backgrounds are all the same transparent token - the cells are kept because an
       app that overrides one by upstream's name has to reach it. -->
  <Style x:Key="DefaultCheckBoxStyle" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="32" /><Setter Property="MinWidth" Value="120" /><Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Foreground" Value="{ThemeResource CheckBoxForegroundUnchecked}" />
    <Setter Property="Background" Value="{ThemeResource CheckBoxBackgroundUnchecked}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUnchecked}" />
    <Setter Property="Padding" Value="{ThemeResource CheckBoxPadding}" />
    <Setter Property="Template"><ControlTemplate TargetType="CheckBox">
      <Grid Name="CheckRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Name="CheckSurface" Width="20" Height="20" CornerRadius="4" BorderThickness="{ThemeResource CheckBoxBorderThickness}"
                Background="{ThemeResource CheckBoxCheckBackgroundFillUnchecked}" BorderBrush="{ThemeResource CheckBoxCheckBackgroundStrokeUnchecked}" VerticalAlignment="Center">
          <Grid>
            <Path Name="CheckGlyph" Data="M 2,6 L 5,9 L 12,2" Width="14" Height="12" Stretch="Uniform" StrokeThickness="1.5"
                  Stroke="{ThemeResource CheckBoxCheckGlyphForegroundUnchecked}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
            <Border Name="MixedGlyph" Width="8" Height="2" CornerRadius="1" Background="{ThemeResource CheckBoxCheckGlyphForegroundUnchecked}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
          </Grid>
        </Border>
        <ContentPresenter Name="CheckLabel" Grid.Column="1" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap" />
        <Border Name="CheckFocus" Grid.ColumnSpan="2" Margin="-2,1" CornerRadius="4" BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedPointerOver}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundUncheckedPointerOver}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedPointerOver}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedPointerOver}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedPointerOver}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPointerOver}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPointerOver}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedPressed}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundUncheckedPressed}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedPressed}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedPressed}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedPressed}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPressed}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedPressed}" /></MultiTrigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundChecked}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundChecked}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushChecked}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillChecked}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeChecked}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundChecked}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundChecked}" /><Setter TargetName="CheckGlyph" Property="Opacity" Value="1" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundCheckedPointerOver}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundCheckedPointerOver}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedPointerOver}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedPointerOver}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedPointerOver}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPointerOver}" /><Setter TargetName="CheckGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundCheckedPressed}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundCheckedPressed}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedPressed}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedPressed}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedPressed}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPressed}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedPressed}" /><Setter TargetName="CheckGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminate}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundIndeterminate}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminate}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminate}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminate}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminate}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminate}" /><Setter TargetName="MixedGlyph" Property="Opacity" Value="1" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="{x:Null}" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminatePointerOver}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundIndeterminatePointerOver}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminatePointerOver}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminatePointerOver}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminatePointerOver}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePointerOver}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePointerOver}" /><Setter TargetName="MixedGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="{x:Null}" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminatePressed}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundIndeterminatePressed}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminatePressed}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminatePressed}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminatePressed}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminatePressed}" /><Setter TargetName="MixedGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundUncheckedDisabled}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundUncheckedDisabled}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushUncheckedDisabled}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillUncheckedDisabled}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeUncheckedDisabled}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedDisabled}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundUncheckedDisabled}" /><Setter TargetName="CheckFocus" Property="Opacity" Value="0" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundCheckedDisabled}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundCheckedDisabled}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushCheckedDisabled}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillCheckedDisabled}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeCheckedDisabled}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedDisabled}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundCheckedDisabled}" /><Setter TargetName="CheckGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="{x:Null}" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter TargetName="CheckLabel" Property="Foreground" Value="{ThemeResource CheckBoxForegroundIndeterminateDisabled}" /><Setter TargetName="CheckRoot" Property="Background" Value="{ThemeResource CheckBoxBackgroundIndeterminateDisabled}" /><Setter TargetName="CheckRoot" Property="BorderBrush" Value="{ThemeResource CheckBoxBorderBrushIndeterminateDisabled}" /><Setter TargetName="CheckSurface" Property="Background" Value="{ThemeResource CheckBoxCheckBackgroundFillIndeterminateDisabled}" /><Setter TargetName="CheckSurface" Property="BorderBrush" Value="{ThemeResource CheckBoxCheckBackgroundStrokeIndeterminateDisabled}" /><Setter TargetName="CheckGlyph" Property="Stroke" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminateDisabled}" /><Setter TargetName="MixedGlyph" Property="Background" Value="{ThemeResource CheckBoxCheckGlyphForegroundIndeterminateDisabled}" /><Setter TargetName="MixedGlyph" Property="Opacity" Value="1" /></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="Opacity" Value="1" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}" />

  <!-- ComboBox on upstream's row set (audits/combobox.md). The framework keeps ownership of five parts -
       OnApplyTemplate looks up PART_ToggleButton, PART_Popup, PART_EditableTextBox, PART_SelectionPresenter
       and PART_DropDownArea, then writes the editable box's Visibility, the selection box item, the popup
       width and the chevron's own Path.Data (measured: opening the dropdown replaced "M 0,1.5 L 5,6.5
       L 10,1.5" with its flipped twin and set no RenderTransform). The template therefore drives colour
       only, never those four things. The focus visual is upstream's HighlightBackground halo rather than
       the two-pixel ring the button and checkbox use, because a halo is what the Focused state raises.
       DropDownGlyph lives inside the toggle's own template, so the chevron colour rides the toggle's
       Foreground: a style setter supplies the resting row and the cells below rewrite the property. -->
  <Style x:Key="ComboBoxDropDownGlyphStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForeground}" />
  </Style>
  <Style x:Key="DefaultComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Padding" Value="{ThemeResource ComboBoxPadding}" />
    <Setter Property="MaxDropDownHeight" Value="504" />
    <Setter Property="Foreground" Value="{ThemeResource ComboBoxForeground}" />
    <Setter Property="Background" Value="{ThemeResource ComboBoxBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ComboBoxBorderBrush}" />
    <Setter Property="BorderThickness" Value="{ThemeResource ComboBoxBorderThemeThickness}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="38" /></Grid.ColumnDefinitions>
        <Border Name="HighlightBackground" Grid.ColumnSpan="2" Margin="-4" Background="{ThemeResource ComboBoxBackgroundFocused}" BorderBrush="{ThemeResource ComboBoxBackgroundBorderBrushFocused}" BorderThickness="{ThemeResource ComboBoxBackgroundBorderThicknessFocused}" CornerRadius="{ThemeResource ComboBoxHiglightBorderCornerRadius}" Opacity="0" IsHitTestVisible="False" />
        <Border Name="PART_MainBorder" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" MinWidth="64" />
        <ContentPresenter Name="PART_SelectionPresenter" Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
        <TextBox Name="PART_EditableTextBox" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}" IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" MinHeight="0" MinWidth="0" Padding="{ThemeResource ComboBoxEditableTextPadding}" CornerRadius="{TemplateBinding CornerRadius}" VerticalContentAlignment="Center" />
        <Border Name="DropDownOverlay" Grid.Column="1" Width="30" Margin="4" HorizontalAlignment="Right" CornerRadius="{ThemeResource ComboBoxDropDownButtonBackgroundCornerRadius}" Background="Transparent" Visibility="Collapsed" IsHitTestVisible="False" />
        <Grid Name="PART_DropDownArea" Grid.Column="1" Background="Transparent">
          <ToggleButton Name="PART_ToggleButton" Style="{StaticResource ComboBoxDropDownGlyphStyle}" IsChecked="{TemplateBinding IsDropDownOpen}" MinHeight="0" MinWidth="0" Padding="0" BorderThickness="0" Background="Transparent" Focusable="False">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Grid Background="Transparent"><Path Name="DropDownGlyph" Data="M 0,1.5 L 5,6.5 L 10,1.5" Width="12" Height="12" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.25" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" /></Grid>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
        </Grid>
        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ComboBox}}">
          <Border Name="PART_PopupBorder" Margin="0,-0.5,0,-1" HorizontalAlignment="Stretch" Background="{ThemeResource ComboBoxDropDownBackground}" BorderBrush="{ThemeResource ComboBoxDropDownBorderBrush}" BorderThickness="{ThemeResource ComboBoxDropdownBorderThickness}" Padding="{ThemeResource ComboBoxDropdownBorderPadding}" CornerRadius="{ThemeResource OverlayCornerRadius}">
            <ScrollViewer Name="PART_ScrollViewer" Foreground="{ThemeResource ComboBoxDropDownForeground}" MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top"><ItemsPresenter Margin="{ThemeResource ComboBoxDropdownContentMargin}" /></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="SelectedIndex" Value="-1"><Setter TargetName="PART_SelectionPresenter" Property="Foreground" Value="{ThemeResource ComboBoxPlaceHolderForeground}" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_MainBorder" Property="Background" Value="{ThemeResource ComboBoxBackgroundPointerOver}" /><Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ComboBoxBorderBrushPointerOver}" /><Setter Property="Foreground" Value="{ThemeResource ComboBoxForegroundPointerOver}" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="SelectedIndex" Value="-1" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SelectionPresenter" Property="Foreground" Value="{ThemeResource ComboBoxPlaceHolderForegroundPointerOver}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="DropDownOverlay" Property="Background" Value="{ThemeResource ComboBoxDropDownBackgroundPointerOver}" /></MultiTrigger>
        <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="PART_MainBorder" Property="Background" Value="{ThemeResource ComboBoxBackgroundPressed}" /><Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ComboBoxBorderBrushPressed}" /><Setter Property="Foreground" Value="{ThemeResource ComboBoxForegroundPressed}" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="SelectedIndex" Value="-1" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SelectionPresenter" Property="Foreground" Value="{ThemeResource ComboBoxPlaceHolderForegroundPressed}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEditable" Value="True" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="DropDownOverlay" Property="Background" Value="{ThemeResource ComboBoxDropDownBackgroundPointerPressed}" /></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HighlightBackground" Property="Opacity" Value="1" /><Setter Property="Foreground" Value="{ThemeResource ComboBoxForegroundFocused}" /><Setter TargetName="PART_ToggleButton" Property="Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundFocused}" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="SelectedIndex" Value="-1" /><Condition Property="IsKeyboardFocused" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SelectionPresenter" Property="Foreground" Value="{ThemeResource ComboBoxPlaceHolderForegroundFocused}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="DropDownOverlay" Property="Background" Value="{ThemeResource ComboBoxFocusedDropDownBackgroundPointerOver}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions><Setter Property="Foreground" Value="{ThemeResource ComboBoxForegroundFocusedPressed}" /><Setter TargetName="PART_ToggleButton" Property="Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundFocusedPressed}" /><Setter TargetName="DropDownOverlay" Property="Background" Value="{ThemeResource ComboBoxFocusedDropDownBackgroundPointerPressed}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="SelectedIndex" Value="-1" /><Condition Property="IsKeyboardFocused" Value="True" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="PART_SelectionPresenter" Property="Foreground" Value="{ThemeResource ComboBoxPlaceHolderForegroundFocusedPressed}" /></MultiTrigger>
        <Trigger Property="IsEditable" Value="True"><Setter TargetName="DropDownOverlay" Property="Visibility" Value="Visible" /><Setter TargetName="PART_ToggleButton" Property="Foreground" Value="{ThemeResource ComboBoxEditableDropDownGlyphForeground}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PART_MainBorder" Property="Background" Value="{ThemeResource ComboBoxBackgroundDisabled}" /><Setter TargetName="PART_MainBorder" Property="BorderBrush" Value="{ThemeResource ComboBoxBorderBrushDisabled}" /><Setter Property="Foreground" Value="{ThemeResource ComboBoxForegroundDisabled}" /><Setter TargetName="PART_ToggleButton" Property="Foreground" Value="{ThemeResource ComboBoxDropDownGlyphForegroundDisabled}" /><Setter TargetName="HighlightBackground" Property="Opacity" Value="0" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}" />
  <!-- Upstream's item: the same nine cells its CombinedStates group writes, with the pill raised by every
       selected state. ComboBoxItem has no IsPressed property on this runtime (measured: it inherits
       IsSelected from ListBoxItem and adds IsHighlighted, which the ComboBox sets for the item under the
       pointer or the keyboard), so the pointer cells take IsMouseOver and IsHighlighted together and the
       press cells take IsMouseCaptureWithin. -->
  <Style x:Key="DefaultComboBoxItemStyle" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{ThemeResource ComboBoxItemForeground}" />
    <Setter Property="Background" Value="{ThemeResource ComboBoxItemBackground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrush}" />
    <Setter Property="Padding" Value="{ThemeResource ComboBoxItemThemePadding}" />
    <Setter Property="CornerRadius" Value="{ThemeResource ComboBoxItemCornerRadius}" />
    <Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><ControlTemplate TargetType="ComboBoxItem">
      <!-- Upstream carries the row inset on the template root (ComboBox_themeresources.xaml:614, Margin="5,2,5,2"),
           not in the item padding: the highlight and the pill stop 5 DIP short of the dropdown border while the
           text keeps its own 11. A literal here because upstream's literal is a literal, not a row. -->
      <Grid Margin="5,2,5,2">
        <Border Name="LayoutRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" />
        <Border Name="Pill" Width="3" Height="16" CornerRadius="{ThemeResource ComboBoxItemPillCornerRadius}" Margin="1,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource ComboBoxItemPillFillBrush}" Opacity="0" IsHitTestVisible="False" />
        <ContentPresenter Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextWrapping="Wrap" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundPointerOver}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushPointerOver}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" /></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundPointerOver}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushPointerOver}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundPointerOver}" /></Trigger>
        <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundPressed}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushPressed}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundPressed}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundSelected}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushSelected}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundSelected}" /><Setter TargetName="Pill" Property="Opacity" Value="1" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundSelectedPointerOver}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushSelectedPointerOver}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundSelectedPointerOver}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsHighlighted" Value="True" /></MultiTrigger.Conditions><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundSelectedPointerOver}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushSelectedPointerOver}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundSelectedPointerOver}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseCaptureWithin" Value="True" /></MultiTrigger.Conditions><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundSelectedPressed}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushSelectedPressed}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundSelectedPressed}" /></MultiTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundDisabled}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushDisabled}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundDisabled}" /><Setter TargetName="Pill" Property="Opacity" Value="0" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False" /><Condition Property="IsSelected" Value="True" /></MultiTrigger.Conditions><Setter TargetName="LayoutRoot" Property="Background" Value="{ThemeResource ComboBoxItemBackgroundSelectedDisabled}" /><Setter TargetName="LayoutRoot" Property="BorderBrush" Value="{ThemeResource ComboBoxItemBorderBrushSelectedDisabled}" /><Setter TargetName="ContentPresenter" Property="Foreground" Value="{ThemeResource ComboBoxItemForegroundSelectedDisabled}" /><Setter TargetName="Pill" Property="Opacity" Value="1" /></MultiTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}" />
</ResourceDictionary>
