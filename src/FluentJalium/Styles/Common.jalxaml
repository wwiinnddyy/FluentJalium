<!-- WinUI Button and ToggleButton state resources @19e3bdc3c (MIT).
     Jalium ButtonBase retains native command, keyboard and pointer semantics.
     Elevation uses a solid stroke adapter, not the upstream gradient stroke. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <ControlTemplate x:Key="ButtonSurfaceTemplate" TargetType="ButtonBase">
    <Grid Background="Transparent">
      <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Padding="{TemplateBinding Padding}" TransitionProperty="Background, BorderBrush" TransitionDuration="0:0:0.083">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          ContentStringFormat="{TemplateBinding ContentStringFormat}" Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Border>
      <Border Name="FocusOutline" Margin="1" BorderThickness="2" CornerRadius="4"
              BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False">
        <Border BorderThickness="1" CornerRadius="2" BorderBrush="{ThemeResource FocusStrokeColorInnerBrush}" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="1" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusOutline" Property="Opacity" Value="0" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="ButtonLayoutStyle" TargetType="ButtonBase">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource ButtonSurfaceTemplate}" />
  </Style>
  <Style x:Key="DefaultButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource ControlFillColorDisabledBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorOnAccentDefaultBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource AccentFillColorDisabledBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorDisabledBrush}" /><Setter Property="BorderBrush" Value="Transparent" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SubtleButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DefaultToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorSecondaryBrush}" /></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource ControlFillColorDisabledBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource AccentFillColorDisabledBrush}" /><Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorDisabledBrush}" /></MultiTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DefaultHyperlinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource SubtleButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorSecondaryBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorTertiaryBrush}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource DefaultButtonStyle}" />
  <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}" />
  <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" />

  <!-- WinUI 3 DefaultToolTipStyle @19e3bdc3c, blob 281d1efcf02c33f81b32fd04e2c691da9173a323. The root is
       a Border here while upstream puts the chrome on a ContentPresenter; the drawn result is the same
       and audits/tooltip.md records it as a shape difference rather than a claim of structural parity.
       FontSize stays a literal: upstream reads it from ToolTipContentThemeFontSize, an x:Double this
       runtime's reader cannot parse. -->
  <Style x:Key="DefaultToolTipStyle" TargetType="ToolTip">
    <Setter Property="Background" Value="{ThemeResource ToolTipBackgroundBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource ToolTipForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}" /><Setter Property="BorderThickness" Value="{ThemeResource ToolTipBorderThemeThickness}" />
    <Setter Property="Padding" Value="{ThemeResource ToolTipBorderPadding}" /><Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" /><Setter Property="FontSize" Value="12" /><Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template"><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" MaxWidth="{TemplateBinding MaxWidth}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}" />
</ResourceDictionary>
