<!-- WinUI Button and ToggleButton state resources @19e3bdc3c (MIT).
     Jalium ButtonBase retains native command, keyboard and pointer semantics.
     Elevation uses a solid stroke adapter, not the upstream gradient stroke. -->
<ResourceDictionary xmlns="http://schemas.jalium.ui/2024" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <ControlTemplate x:Key="ButtonSurfaceTemplate" TargetType="ButtonBase">
    <Grid Background="Transparent">
      <Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Padding="{TemplateBinding Padding}" TransitionProperty="Background, BorderBrush" TransitionDuration="0:0:0.083">
        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          ContentStringFormat="{TemplateBinding ContentStringFormat}" Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Border>
      <Border Name="FocusOutline" Margin="1" BorderThickness="2" CornerRadius="4"
              BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}" Opacity="0" IsHitTestVisible="False">
        <Border BorderThickness="1" CornerRadius="2" BorderBrush="{ThemeResource FocusStrokeColorInnerBrush}" />
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="1" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusOutline" Property="Opacity" Value="0" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="ButtonLayoutStyle" TargetType="ButtonBase">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" /><Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource ButtonSurfaceTemplate}" />
  </Style>
  <Style x:Key="DefaultButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource ButtonBackgroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource ButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource ButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource ButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource ButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource AccentButtonBackgroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource AccentButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource AccentButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource AccentButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource AccentButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrushDisabled}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SubtleButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource SubtleButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource SubtleButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource SubtleButtonBackgroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource SubtleButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource SubtleButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource SubtleButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource SubtleButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource SubtleButtonBorderBrushDisabled}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DefaultToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource ToggleButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource ToggleButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource ToggleButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundChecked}" /><Setter Property="Foreground" Value="{ThemeResource ToggleButtonForegroundChecked}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushChecked}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundCheckedPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushCheckedPointerOver}" /></MultiTrigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsPressed" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundCheckedPressed}" /><Setter Property="Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushCheckedPressed}" /></MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource ToggleButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushDisabled}" /></Trigger>
      <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True" /><Condition Property="IsEnabled" Value="False" /></MultiTrigger.Conditions><Setter Property="Background" Value="{ThemeResource ToggleButtonBackgroundCheckedDisabled}" /><Setter Property="Foreground" Value="{ThemeResource ToggleButtonForegroundCheckedDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource ToggleButtonBorderBrushCheckedDisabled}" /></MultiTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DefaultRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource RepeatButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource RepeatButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource RepeatButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource RepeatButtonBackgroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource RepeatButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource RepeatButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource RepeatButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource RepeatButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource RepeatButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource RepeatButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource RepeatButtonBorderBrushDisabled}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DefaultHyperlinkButtonStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource ButtonLayoutStyle}">
    <Setter Property="Background" Value="{ThemeResource HyperlinkButtonBackground}" />
    <Setter Property="Foreground" Value="{ThemeResource HyperlinkButtonForeground}" />
    <Setter Property="BorderBrush" Value="{ThemeResource HyperlinkButtonBorderBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{ThemeResource HyperlinkButtonBackgroundPointerOver}" /><Setter Property="Foreground" Value="{ThemeResource HyperlinkButtonForegroundPointerOver}" /><Setter Property="BorderBrush" Value="{ThemeResource HyperlinkButtonBorderBrushPointerOver}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{ThemeResource HyperlinkButtonBackgroundPressed}" /><Setter Property="Foreground" Value="{ThemeResource HyperlinkButtonForegroundPressed}" /><Setter Property="BorderBrush" Value="{ThemeResource HyperlinkButtonBorderBrushPressed}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{ThemeResource HyperlinkButtonBackgroundDisabled}" /><Setter Property="Foreground" Value="{ThemeResource HyperlinkButtonForegroundDisabled}" /><Setter Property="BorderBrush" Value="{ThemeResource HyperlinkButtonBorderBrushDisabled}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
  <Style TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}" />
  <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}" />
  <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" />

  <!-- WinUI 3 DefaultScrollViewerStyle @19e3bdc3c, blob 800d5040a5e73c28b75c5c5d2f4af40c7a48256b. Only the
       setters this runtime has and can verify are here: IsTabStop, Padding, BorderThickness,
       BorderBrush, Background and the two content alignments. HorizontalScrollMode/VerticalScrollMode,
       IsVerticalRailEnabled/IsHorizontalRailEnabled and UseSystemFocusVisuals do not exist on
       Jalium's ScrollViewer at all, and VerticalScrollBarVisibility deliberately stays at the
       framework's Auto because 26.10.9 cannot reproduce the indicator states that let WinUI show a
       Visible bar invisibly at rest - see audits/scrollviewer.md. -->
  <Style x:Key="DefaultScrollViewerStyle" TargetType="ScrollViewer">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}" />

  <!-- WinUI 3 DefaultToolTipStyle @19e3bdc3c, blob 281d1efcf02c33f81b32fd04e2c691da9173a323. The root is
       a Border here while upstream puts the chrome on a ContentPresenter; the drawn result is the same
       and audits/tooltip.md records it as a shape difference rather than a claim of structural parity.
       FontSize stays a literal: upstream reads it from ToolTipContentThemeFontSize, an x:Double this
       runtime's reader cannot parse. -->
  <Style x:Key="DefaultToolTipStyle" TargetType="ToolTip">
    <Setter Property="Background" Value="{ThemeResource ToolTipBackgroundBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource ToolTipForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ToolTipBorderBrush}" /><Setter Property="BorderThickness" Value="{ThemeResource ToolTipBorderThemeThickness}" />
    <Setter Property="Padding" Value="{ThemeResource ToolTipBorderPadding}" /><Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" /><Setter Property="FontSize" Value="12" /><Setter Property="MaxWidth" Value="320" />
    <Setter Property="Template"><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" MaxWidth="{TemplateBinding MaxWidth}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style></ContentPresenter.Resources></ContentPresenter></Border></ControlTemplate></Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}" />
</ResourceDictionary>
