<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        WinUI Standard Name Aliases
        Maps WinUI-standard resource names to FluentJalium's short-form names.
        Both naming conventions are supported for backward compatibility.

        Convention: WinUI uses "Surface + Function + State" pattern
        Example: TextFillColorPrimaryBrush, ControlFillColorDefaultBrush

        Theme-specific values live in FluentColors.jalxaml and FluentMaterials.jalxaml, which
        already publish both the WinUI name and the Fluent-prefixed name for every token, so this
        dictionary carries no values itself.
    -->
</ResourceDictionary>
