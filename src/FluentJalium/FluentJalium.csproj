<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FluentJalium</RootNamespace>
    <AssemblyName>FluentJalium</AssemblyName>
    <Description>Source-audited WinUI 3 styles and native Jalium controls. Astra implementation.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>FluentJalium</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <EnableJalxamlCodeGeneration>false</EnableJalxamlCodeGeneration>
    <EnableJalxamlRazorTransform>false</EnableJalxamlRazorTransform>
    <!-- Runtime resource parsing is intentional; trimming/AOT is not certified. -->
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Astra/**/*.cs" />
    <EmbeddedResource Include="Astra/Resources/**/*.jalxaml">
      <LogicalName>Resources/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Astra/Resources/Manifest.txt">
      <LogicalName>Resources/Manifest.txt</LogicalName>
    </EmbeddedResource>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jalium.UI.Controls" Version="$(JaliumPackageVersion)" />
    <PackageReference Include="Jalium.UI.Xaml" Version="$(JaliumPackageVersion)" />
  </ItemGroup>
</Project>
