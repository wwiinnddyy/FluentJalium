<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-logic only package: MSBuild props/targets, no assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>FluentJalium.WinUI.Build</PackageId>
    <Description>MSBuild integration for FluentJalium.WinUI: makes an app's WinUI .xaml files visible to the Jalium markup compiler.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NU5128: no lib/ or ref/ assemblies, which is intentional for a build-logic package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="buildTransitive\**\*.props;buildTransitive\**\*.targets"
          PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
