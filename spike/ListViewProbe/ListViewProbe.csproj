<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the second slice of the list batch (docs/astra/audits/listview.md, stage 5): what the
       runtime actually offers for ListView / ListViewItem / GridView, whether a ListView takes our template the
       way a ListBox does (adaptation/00 S1-c), whether the implicit container style route is the same one, which
       state flags the container exposes for the upstream ListViewItem cell matrix, and what the 12 DIP gutter
       (S0-u, S1-c 7) looks like on the grid surface. Answers the "re-template or own type" question before any
       product code exists. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ListViewProbe</RootNamespace>
    <AssemblyName>ListViewProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
