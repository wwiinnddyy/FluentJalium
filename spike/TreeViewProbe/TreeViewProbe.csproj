<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the third slice of the list batch (stage 5): what the runtime actually offers for
       TreeView / TreeViewItem, whether the WinUI TreeView shape (a flattened TreeViewList of ListViewItem-derived
       rows, controls/dev/TreeView/TreeViewItem.xaml) has any counterpart here, whether the nested WPF shape
       (TreeViewItem : HeaderedItemsControl) can take our template, and what the expand/collapse route actually
       is - the chevron's part name, a two-way TemplatedParent binding, or a framework hook. Answers the
       "re-template or own type" question before any product code exists. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TreeViewProbe</RootNamespace>
    <AssemblyName>TreeViewProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
