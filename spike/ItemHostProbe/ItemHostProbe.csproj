<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the stage-5 tail: what does this runtime actually give an author who needs a WinUI
       RadioButtons / BreadcrumbBar / PipsPager, and is the runtime's GridView the same control as WinUI's?
       Answers are read off the shipped 26.10.9 assembly by reflection and off a mounted control by layout, never
       from the type graph's name. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ItemHostProbe</RootNamespace>
    <AssemblyName>ItemHostProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
