<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the stage-6 icon family: what the runtime's SymbolIcon / FontIcon / PathIcon do when a
       real one is mounted - whether they build a visual, what it says, what box it asks for, whether markup can
       set it at all, and whether any of it reaches a capture. Answers come from read-backs off mounted elements
       and from rendered ink, never from a type or property name. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IconFamilyProbe</RootNamespace>
    <AssemblyName>IconFamilyProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
