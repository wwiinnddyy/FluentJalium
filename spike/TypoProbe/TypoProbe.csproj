<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway typography-knob probe. Not referenced by FluentJalium.slnx.
       Asks the shipped 26.10.9 runtime whether the framework's own public typography entry point can move the
       body size our styles inherit (measured 12) up to the upstream number (ControlContentThemeFontSize=14). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TypoProbe</RootNamespace>
    <AssemblyName>TypoProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
