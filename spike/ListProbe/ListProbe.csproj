<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the four questions the list batch has to answer before any product code is written
       (docs/astra/audits/listbox.md, to be written): (A) which list types exist with what property surface and
       whether they arrive with a framework-built Template rather than a Style (adaptation/00 S0-h), (B) the
       part names the shipped templates actually use, (C) whether ListBox accepts a re-template at all - the
       UseTemplateContentManagement lock from S0-m - and which of those names a template has to keep for items
       to appear, (D) virtualization and the S0-u scrollbar asymmetry measured on a real list. Not referenced by
       FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ListProbe</RootNamespace>
    <AssemblyName>ListProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
