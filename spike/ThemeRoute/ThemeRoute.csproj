<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway metadata probe: finds which theme APIs are marked experimental and what the
       public entry points actually call. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThemeRoute</RootNamespace>
    <AssemblyName>ThemeRoute</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
  </ItemGroup>
</Project>
