<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the motion slice of the "并行" item (减动效资源键化). The question is whether a duration
       can be published as a theme resource at all on this runtime, whether a runtime flip of that row reaches an
       element that is already loaded and shown, and whether flipping it to zero really stops the animation - the
       framework reads TransitionDuration at arm time and returns "no transition" for anything at or below zero, so
       the shape is promising but unproven. Answers come from read-backs off mounted elements, never from a property
       name. Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MotionProbe</RootNamespace>
    <AssemblyName>MotionProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
