<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway calendar-family probe. Not referenced by FluentJalium.slnx.
       Asks whether Calendar / DatePicker / TimePicker really render nothing on the shipped 26.10.9, or whether the
       earlier "0 visual children" reading was the shape of a control that draws itself in OnRender. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CalendarProbe</RootNamespace>
    <AssemblyName>CalendarProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
