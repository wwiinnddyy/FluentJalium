<Project Sdk="Microsoft.NET.Sdk">
  <!-- Throwaway probe for the PipsPager slice: which members of the shipped 26.10.9 assembly the control can
       actually be written against, and what the three upstream symbol codepoints become in pixels on this
       machine. Answers come from reflection and from a rendered capture, never from the type name.
       Not referenced by FluentJalium.slnx. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PipsPagerProbe</RootNamespace>
    <AssemblyName>PipsPagerProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultJalxamlItems>false</EnableDefaultJalxamlItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Jalium.UI.Desktop" Version="26.10.9" />
    <ProjectReference Include="..\..\src\FluentJalium\FluentJalium.csproj" />
  </ItemGroup>
</Project>
